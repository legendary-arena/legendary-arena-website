# Hugo build outputs
public/
resources/
.hugo_build.lock
hugo_stats.json

# Node modules (some Hugo themes pull JS dependencies)
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code local settings (per-machine, not shared)
.claude/settings.local.json

# Environment files
.env
.env.local

# Build artifacts from theme tooling
.cache/

# WP-005: local-only verification artifacts
# why: lighthouse-*.json and build1/2.txt are produced by the WP-005
# verification flow (Lighthouse audits + reproducibility hash diff).
# They are local-only — see WP-005 § Step 8.5 / 8.7 + the WP-005 lock
# entry in 03-ROADMAP.md.
lighthouse-*.json
build1.txt
build2.txt

# Logo-figma scratch artifacts
# why: project uses pnpm (per pnpm-workspace.yaml); npm-generated lockfiles are stale.
# why: zips are Figma Make export archives — would pollute history on re-export.
docs/brand/logo-figma/package-lock.json
docs/brand/logo-figma/*.zip

# WP invocation scratchpads
# why: preflight / context / session prompt files under docs/ai/invocations/
# behave like REPL transcripts — they help the executor that day but rarely
# carry information future WPs depend on. The reconciled session-context
# file (docs/ai/session-context/...) is the artifact future WPs read.
# Mirrors the engine repo's convention. Override with `git add -f <path>`
# if a specific WP cites an invocation file as a normative artifact.
docs/ai/invocations/preflight-wp*.md
docs/ai/invocations/context-wp*.md
docs/ai/invocations/session-wp*.md