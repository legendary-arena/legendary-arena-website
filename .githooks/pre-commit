#!/bin/sh
# pre-commit hook — marketing-site staged-file hygiene
# Enforces: no secrets, no Hugo build outputs, no local verification artifacts.
# Message-based checks live in commit-msg (pre-commit has no message access).
#
# Contract: docs/ai/REFERENCE/01.3-commit-hygiene.md

RED='\033[0;31m'
NC='\033[0m'

fail() {
  echo ""
  echo "${RED}PRE-COMMIT BLOCKED:${NC} $1"
  echo ""
  exit 1
}

# Get staged files (added, modified, copied, renamed)
STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)

if [ -z "$STAGED" ]; then
  exit 0
fi

# Rule 1: No .env files (may contain secrets) — .env.example is allowed
echo "$STAGED" | grep -E '\.env$|\.env\.' | grep -vq '\.env\.example$'
if [ $? -eq 0 ]; then
  fail "Staged .env file detected (not .env.example). Remove from staging: git reset HEAD <file>"
fi

# Rule 2: No node_modules
echo "$STAGED" | grep -q 'node_modules/' && \
  fail "Staged node_modules/ files detected. node_modules/ is gitignored — if it's staged, run: git reset HEAD node_modules/"

# Rule 3: No public/ (Hugo build output)
echo "$STAGED" | grep -qE '^public/' && \
  fail "Staged public/ files detected. public/ is gitignored Hugo build output. Run: git reset HEAD public/"

# Rule 4: No resources/ (Hugo asset cache)
echo "$STAGED" | grep -qE '^resources/' && \
  fail "Staged resources/ files detected. resources/ is gitignored Hugo asset cache. Run: git reset HEAD resources/"

# Rule 5: No .hugo_build.lock
echo "$STAGED" | grep -q '\.hugo_build\.lock$' && \
  fail "Staged .hugo_build.lock detected. This is gitignored — run: git reset HEAD .hugo_build.lock"

# Rule 6: No credentials files
echo "$STAGED" | grep -qiE 'credentials\.json|secrets\.json|\.pem$|\.key$' && \
  fail "Staged credentials or key file detected. Do not commit secrets."

# Rule 7: No local Lighthouse verification artifacts
# why: lighthouse-*.json files are produced by WP-005 § Step 8.5 / 8.7
# verification and are local-only per the WP-005 lock entry. Scores are
# recorded in 03-ROADMAP.md and 01-VISION.md decisions log, not in the
# repo as JSON.
echo "$STAGED" | grep -qE '^lighthouse-.*\.json$' && \
  fail "Staged lighthouse-*.json detected. Lighthouse artifacts are local-only per WP-005. Run: git reset HEAD lighthouse-*.json"

# Rule 8: No build1.txt / build2.txt scratch files
# why: build1.txt / build2.txt are produced by WP-005 reproducibility hash
# diff and are gitignored. If they're staged, .gitignore was bypassed.
echo "$STAGED" | grep -qE '^build[0-9]+\.txt$' && \
  fail "Staged build*.txt detected. These are WP-005 reproducibility scratch files. Run: git reset HEAD build*.txt"

# Rule 9: Gauntlet Guide posts must come from the gauntlet-guide archetype
# why: the archetype at archetypes/gauntlet-guide.md is not a front-matter
# stub — it carries the DERIVED/JUDGMENT/BLOCKED editorial rules the series
# is held to (WP-038). A guide hand-written from a previous post silently
# loses them. Documentation alone did not hold: the ewiki carried a stale
# "add the fields by hand" instruction for a month. So this is enforced.
#
# Detection is by series/category, not filename, so a differently-named
# gauntlet post is still caught.
GAUNTLET_POSTS=$(echo "$STAGED" | grep -E '^content/posts/.*\.md$' || true)
for POST in $GAUNTLET_POSTS; do
  [ -f "$POST" ] || continue
  grep -qE '^series:[[:space:]]*"Gauntlet Guides"|gauntlet-guides' "$POST" || continue

  # 9a. Archetype front matter must be present.
  for FIELD in gauntlet_set gauntlet_mastermind gauntlet_board guide_version; do
    grep -qE "^${FIELD}:" "$POST" || fail "$POST looks like a Gauntlet Guide but is missing '${FIELD}:'.
Generate it from the archetype instead of copying a previous post:
  hugo new content posts/<slug>.md --kind gauntlet-guide
The archetype (archetypes/gauntlet-guide.md) carries the editorial rules
for this series, not just the fields. See wiki/blog-post-authoring.md."
  done

  # 9b. The honesty section is required while PAR is unpublished.
  grep -qE '^## What this section will say later' "$POST" || fail "$POST is a Gauntlet Guide with no 'What this section will say later' section.
That section is REQUIRED by the archetype: it states that the guidance comes
from card text and the scoring model rather than observed results. Do not
delete it until PAR publishes and boards accept entries."

  # 9c. BLOCKED claims — no competitive score data exists to support these.
  # legendary.competitive_scores is empty and PAR is deliberately
  # unpublished, so every one of these would be invented authority.
  BLOCKED_HIT=$(grep -nEi 'PAR -[0-9]|estimated competitive|expected results|clear rate|score risk[[:space:]]*:|difficulty[[:space:]]*:.*(easy|medium|hard)|[0-9]+/10|⭐' "$POST" | head -n 3 || true)
  if [ -n "$BLOCKED_HIT" ]; then
    fail "$POST contains claims the archetype BLOCKS — no competitive score data exists.
$BLOCKED_HIT

PAR is unpublished and legendary.competitive_scores is empty, so PAR ranges,
difficulty/score-risk ratings, expected-results tables and clear rates would
be fabricated authority on a public page. Leave the gap visible.
See the BLOCKED list in archetypes/gauntlet-guide.md."
  fi
done

exit 0
